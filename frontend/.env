# Google Identity Services Client ID
# Get this from: https://console.cloud.google.com → APIs & Services → Credentials
# Make sure http://localhost:5173 is in "Authorized JavaScript origins"
VITE_GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

